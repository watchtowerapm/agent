<?php

namespace WatchtowerAgent;

require __DIR__.'/vendor/autoload.php';

use RuntimeException;
use Throwable;
use Watchtower\LaravelAgent\Frame;
use Watchtower\LaravelAgent\Protocol;

use function date;
use function hash;
use function is_resource;
use function is_string;
use function json_encode;
use function stream_socket_client;
use function substr;

/*
 * Helpers...
 */

/**
 * @param  resource  $stream
 * @return array<string, mixed>
 */
$readFrame = static function ($stream): array {
    if (! is_resource($stream)) {
        throw new RuntimeException('Expected stream resource');
    }

    $carry = '';

    for ($i = 0; $i < 8192; $i++) {
        if ($carry !== '') {
            try {
                [$message] = Frame::decodeOne($carry, 0);

                return $message;
            } catch (RuntimeException) {
                // Need more bytes.
            }
        }

        $chunk = fread_chunk($stream, 8192);

        if ($chunk === '') {
            throw new RuntimeException("Unexpected response from agent [{$carry}]");
        }

        $carry .= $chunk;
    }

    throw new RuntimeException("Unexpected response from agent [{$carry}]");
};

$info = static function (string $message): void {
    fwrite_all(STDOUT, date('Y-m-d H:i:s').' [INFO] '.$message.PHP_EOL);
};

$error = static function (string $message): void {
    fwrite_all(STDERR, date('Y-m-d H:i:s').' [ERROR] '.$message.PHP_EOL);
};

$bail = static function (string $message) use ($error): never {
    $error($message);

    exit(1);
};

try {
    /*
     * Input...
     */

    $refreshToken = $_SERVER['WATCHTOWER_TOKEN'] ?? getenv('WATCHTOWER_TOKEN') ?: '';
    /** @var string $refreshToken */
    $ingestUri = $_SERVER['WATCHTOWER_INGEST_URI'] ?? '127.0.0.1:2407';
    /** @var string $ingestUri */
    $timeout = $_SERVER['WATCHTOWER_INGEST_TIMEOUT'] ?? 0.5;
    /** @var float $timeout */
    $connectionTimeout = $_SERVER['WATCHTOWER_INGEST_CONNECTION_TIMEOUT'] ?? 0.5;
    /** @var float $connectionTimeout */
    if ($refreshToken === '') {
        $bail('The WATCHTOWER_TOKEN environment variable has not been configured');
    }

    /*
     * Connect to the agent...
     */

    $stream = @stream_socket_client(
        address: "tcp://{$ingestUri}",
        error_code: $errorCode,
        error_message: $errorMessage,
        timeout: $connectionTimeout,
    );

    if ($stream === false) {
        /**
         * @var string $errorMessage
         * @var int $errorCode
         */
        $bail("Failed connecting to the agent: {$errorMessage} [{$errorCode}]");
    }

    /*
     * HELLO + PING the agent...
     */

    $tokenHash = substr(hash('xxh128', $refreshToken), 0, 7);

    try {
        stream_configure_read_timeout($stream, $timeout);

        fwrite_all($stream, Frame::encode([
            'type' => Protocol::TYPE_HELLO,
            'protocol' => Protocol::NAME,
            'protocol_version' => Protocol::VERSION,
            'token_hash' => $tokenHash,
        ]));

        $welcome = $readFrame($stream);

        if (($welcome['type'] ?? null) !== Protocol::TYPE_WELCOME || ($welcome['accepted'] ?? false) !== true) {
            throw new RuntimeException('Unexpected response from agent ['.json_encode($welcome).']');
        }

        $sessionId = $welcome['session_id'] ?? '';

        fwrite_all($stream, Frame::encode([
            'type' => Protocol::TYPE_PING,
            'protocol_version' => Protocol::VERSION,
            'session_id' => is_string($sessionId) ? $sessionId : '',
            'sequence' => 1,
        ]));

        $ack = $readFrame($stream);

        if (
            ($ack['type'] ?? null) !== Protocol::TYPE_ACK
            || ($ack['sequence'] ?? null) !== 1
            || ($ack['rejected'] ?? null) !== 0
        ) {
            throw new RuntimeException('Unexpected response from agent ['.json_encode($ack).']');
        }
    } finally {
        fclose_safely($stream);
    }

    $info('The Watchtower agent is running and accepting connections');
} catch (Throwable $e) {
    $bail($e->getMessage());
}
